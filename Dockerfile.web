# Version web de l'app (app.performx.online) : le même code que l'app mobile, compilé pour
# le navigateur, servi par nginx avec l'API et le temps réel sur la même adresse.
FROM ghcr.io/cirruslabs/flutter:3.38.5 AS build
WORKDIR /app
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get
COPY . .
ARG SENTRY_DSN=
# Moteur d'affichage (CanvasKit, ~2,5 Mo compressé) chargé depuis le réseau de Google, plus
# rapide et plus proche des agents que notre serveur.
RUN flutter build web --release --no-wasm-dry-run --dart-define=SENTRY_DSN=$SENTRY_DSN
# Fichiers compressés une fois pour toutes au niveau maximal (nginx les sert tels quels).
RUN find build/web -type f \( -name '*.js' -o -name '*.wasm' -o -name '*.json' -o -name '*.html' \
      -o -name '*.otf' -o -name '*.ttf' -o -name '*.svg' -o -name '*.css' \) -exec gzip -9 -k -f {} \;

FROM nginx:1.27-alpine
COPY deploy/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 80
